        0,
        300
      ],
      "webhookId": "00ce80c4-585c-455b-b143-ac5ba8777230"
    },
    {
      "parameters": {
        "jsCode": "// Normalize the lead and reject junk before any model call\nconst b = $input.first().json.body || {};\nconst email = String(b.email || '').trim().toLowerCase();\nconst valid = /^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(email) && !!b.message;\nconst freeMail = /@(gmail|yahoo|hotmail|outlook)\\./.test(email);\nreturn [{ json: { name: b.name || '', email, company: b.company || '', message: String(b.message || '').slice(0, 2000), source: b.source || 'form', free_mail: freeMail, valid } }];"
      },
      "id": "b62695d7-db9d-4c7b-93ac-cd7cc97e6d56",
      "name": "Validate Lead",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "40ff578b-b637-4beb-b1dd-338cf87572de",
              "leftValue": "={{ $json.valid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "e01ec1d4-74bd-4258-a49d-ce36facefa09",
      "name": "Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ status: 'received' }) }}",
        "options": {}
      },
      "id": "aa482716-eb32-4701-ae95-042671aefc38",
      "name": "Ack",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        660,
        180
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ status: 'rejected', reason: 'missing email or message' }) }}",
        "options": {
          "responseCode": 422
        }
      },
      "id": "4452c405-9bde-4a38-abe7-1847e3412d52",
      "name": "Reject",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        660,
        440
      ]
    },
    {
      "parameters": {
        "jsCode": "const l = $input.first().json;\nconst prompt = `You qualify inbound B2B leads. Return ONLY JSON:\n{\"score\": 0-100, \"reason\": string (one line), \"draft_reply\": string (short, friendly, no promises on price)}\n\nLead:\nName: ${l.name}\nCompany: ${l.company}\nEmail domain is free mail: ${l.free_mail}\nSource: ${l.source}\nMessage: ${l.message}`;\nreturn [{ json: { ...l, prompt } }];"
      },
      "id": "260c64ce-d893-421b-be25-1f9a2794cae6",
      "name": "Build Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $env.ANTHROPIC_API_KEY }}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'claude-haiku-4-5', max_tokens: 600, messages: [{ role: 'user', content: $json.prompt }] }) }}",
        "options": {
          "timeout": 60000
        }
      },
      "id": "a6ad1c53-c614-4acf-b95d-d083dc4d321a",
      "name": "Claude (Score + Draft)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const lead = $('Build Prompt').first().json;\nlet out = { score: 0, reason: 'Unparseable model output', draft_reply: '' };\ntry { out = JSON.parse($input.first().json.content[0].text); } catch (e) {}\nconst threshold = Number($env.LEAD_SCORE_THRESHOLD || 70);\nreturn [{ json: { ...lead, ...out, hot: Number(out.score) >= threshold, threshold } }];"
      },
      "id": "e7bea9ef-ab60-4090-8e88-a05cfa7ef0bb",
      "name": "Parse Score",
      "type": "n8n-nodes-base.code",
